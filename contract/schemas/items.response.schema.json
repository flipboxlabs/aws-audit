{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "warn",
              "fail",
              "skip"
            ]
          },
          "tier": {
            "default": 2,
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "operation": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "properties": {
              "app": {
                "type": "string"
              },
              "id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "app",
              "type"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "properties": {
              "app": {
                "type": "string"
              },
              "id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "app",
              "type"
            ],
            "additionalProperties": false
          },
          "rerunable": {
            "type": "boolean"
          },
          "trace": {
            "type": "string"
          },
          "createdAt": {},
          "updatedAt": {},
          "related": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "status",
          "tier",
          "operation",
          "target"
        ],
        "additionalProperties": false
      }
    },
    "pagination": {
      "type": "object",
      "properties": {
        "pageSize": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "nextToken": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
