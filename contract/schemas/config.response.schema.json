{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apps": {
      "type": "object",
      "properties": {
        "App1": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Unknown",
              "User",
              "Order"
            ]
          }
        },
        "TestApp": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "User",
              "Order"
            ]
          }
        }
      },
      "required": [
        "App1",
        "TestApp"
      ],
      "additionalProperties": false
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "success",
          "warn",
          "fail",
          "skip"
        ]
      }
    },
    "version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "apps",
    "statuses",
    "version"
  ],
  "additionalProperties": false
}
