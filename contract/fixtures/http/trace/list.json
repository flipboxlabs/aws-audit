{
  "description": "Summaries of a trace's audits, by stage, then oldest first; trace is the stored one",
  "route": "GET /trace/{trace}",
  "request": {
    "method": "GET",
    "path": "/trace/trace-1",
    "query": {
      "filter[app]": "App1"
    }
  },
  "calls": [
    {
      "service": "DynamoDB",
      "command": "Query",
      "input": {
        "ScanIndexForward": true,
        "IndexName": "ByTrace",
        "ExpressionAttributeValues": {
          ":k0": {
            "S": "-"
          },
          ":k1": {
            "S": "trace-1"
          },
          ":scope": {
            "S": "App1"
          }
        },
        "ExpressionAttributeNames": {
          "#k0": "tenantKey",
          "#k1": "traceId",
          "#scopes": "scopes"
        },
        "KeyConditionExpression": "#k0 = :k0 AND #k1 = :k1",
        "TableName": "TEST-Contract-Audit-v2",
        "Limit": 100,
        "FilterExpression": "contains(#scopes, :scope)"
      },
      "output": {
        "Items": [
          {
            "PK": {
              "S": "App1.Order#audit-1"
            },
            "SK": {
              "S": "audit"
            },
            "id": {
              "S": "audit-1"
            },
            "operation": {
              "S": "createOrder"
            },
            "status": {
              "S": "fail"
            },
            "tier": {
              "N": "2"
            },
            "target": {
              "M": {
                "app": {
                  "S": "App1"
                },
                "type": {
                  "S": "Order"
                },
                "id": {
                  "S": "order-1"
                }
              }
            },
            "createdAt": {
              "S": "2026-01-02T03:04:05.678Z"
            },
            "updatedAt": {
              "S": "2026-01-02T03:04:05.678Z"
            },
            "trace": {
              "S": "trace-1:1"
            },
            "tenantKey": {
              "S": "-"
            },
            "traceId": {
              "S": "trace-1"
            },
            "traceStage": {
              "N": "1"
            }
          }
        ]
      }
    }
  ],
  "response": {
    "statusCode": 200,
