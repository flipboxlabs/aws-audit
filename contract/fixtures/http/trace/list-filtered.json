{
  "description": "A trace filtered by resource type, a page at a time",
  "route": "GET /trace/{trace}",
  "request": {
    "method": "GET",
    "path": "/trace/trace-1",
    "query": {
      "pagination[pageSize]": "5",
      "filter[resourceType]": "Order"
    }
  },
  "calls": [
    {
      "service": "DynamoDB",
      "command": "Query",
      "input": {
        "ScanIndexForward": true,
        "IndexName": "ByTrace",
        "ExpressionAttributeValues": {
          ":k0": {
            "S": "-"
          },
          ":k1": {
            "S": "trace-1"
          },
          ":scope": {
            "S": "*#Order"
          }
        },
        "ExpressionAttributeNames": {
          "#k0": "tenantKey",
          "#k1": "traceId",
          "#scopes": "scopes"
        },
        "KeyConditionExpression": "#k0 = :k0 AND #k1 = :k1",
        "TableName": "TEST-Contract-Audit-v2",
        "Limit": 5,
        "FilterExpression": "contains(#scopes, :scope)"
      },
      "output": {
        "Items": []
      }
    }
  ],
  "response": {
    "statusCode": 200,
    "contentType": "application/json",
    "body": {
      "items": [],
      "pagination": {}
    }
  }
}
