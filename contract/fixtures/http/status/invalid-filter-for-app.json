{
  "description": "With filter[app], filter[resourceType] must be one of that app's types",
  "route": "GET /status/{status}",
  "request": {
    "method": "GET",
    "path": "/status/fail",
    "query": {
      "filter[app]": "TestApp",
      "filter[resourceType]": "Unknown"
    }
  },
  "calls": [],
  "response": {
    "statusCode": 422,
    "contentType": "application/json",
    "body": {
      "statusCode": 422,
      "error": "RequestValidationError",
      "message": "Validation failed for request",
      "details": {
        "issues": [
          {
            "message": "Invalid option: expected one of \"User\"|\"Order\"",
            "path": [
              "query",
              "filter[resourceType]"
            ]
          }
        ]
      }
    }
  }
}
