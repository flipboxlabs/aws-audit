{
  "description": "Pagination and filters come from bracketed query parameters; resource filters match the audit's scopes",
  "route": "GET /status/{status}",
  "request": {
    "method": "GET",
    "path": "/status/fail",
    "query": {
      "pagination[pageSize]": "5",
      "filter[app]": "App1",
      "filter[resourceType]": "Order",
      "filter[operation]": "createOrder",
      "filter[tier]": "1"
    }
  },
  "calls": [
    {
      "service": "DynamoDB",
      "command": "Query",
      "input": {
        "ScanIndexForward": false,
        "IndexName": "ByStatus",
        "ExpressionAttributeValues": {
          ":k0": {
            "S": "-"
          },
          ":k1": {
            "S": "fail"
          },
          ":k2": {
            "S": "audit"
          },
          ":operation": {
            "S": "createOrder"
          },
          ":scope": {
            "S": "App1.Order"
          },
          ":tier": {
            "N": "1"
          }
        },
        "ExpressionAttributeNames": {
          "#k0": "tenantKey",
          "#k1": "status",
          "#k2": "kind",
          "#operation": "operation",
          "#scopes": "scopes",
          "#tier": "tier"
        },
        "KeyConditionExpression": "#k0 = :k0 AND #k1 = :k1 AND #k2 = :k2",
        "TableName": "TEST-Contract-Audit-v2",
        "Limit": 5,
        "FilterExpression": "#operation = :operation AND #tier = :tier AND contains(#scopes, :scope)"
      },
      "output": {
        "Items": []
      }
    }
  ],
  "response": {
    "statusCode": 200,
    "contentType": "application/json",
    "body": {
      "items": [],
      "pagination": {}
    }
  }
}
