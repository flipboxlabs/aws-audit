{
  "description": "A DynamoDB failure is a logged 500",
  "route": "GET /status/{status}",
  "request": {
    "method": "GET",
    "path": "/status/fail"
  },
  "calls": [
    {
      "service": "DynamoDB",
      "command": "Query",
      "input": {
        "ScanIndexForward": false,
        "IndexName": "ByStatus",
        "ExpressionAttributeValues": {
          ":k0": {
            "S": "-"
          },
          ":k1": {
            "S": "fail"
          },
          ":k2": {
            "S": "audit"
          }
        },
        "ExpressionAttributeNames": {
          "#k0": "tenantKey",
          "#k1": "status",
          "#k2": "kind"
        },
        "KeyConditionExpression": "#k0 = :k0 AND #k1 = :k1 AND #k2 = :k2",
        "TableName": "TEST-Contract-Audit-v2",
        "Limit": 100
      },
      "error": {
        "name": "ProvisionedThroughputExceededException",
        "message": "Slow down"
      }
    }
  ],
  "response": {
    "statusCode": 500,
    "contentType": "application/json",
    "body": {
      "statusCode": 500,
      "error": "InternalServerError",
      "message": "Internal Server Error"
    }
  }
}
